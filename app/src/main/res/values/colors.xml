    <!-- Disabled control states. Every button in the dashboard pinned a
         flat textColor/backgroundTint, so setEnabled(false) changed nothing
         on screen and the operator saw five live-looking buttons that did
         nothing when pressed. -->
    <color name="control_disabled_fill">#DDE3EA</color>
    <color name="control_disabled_text">#98A2B3</color>
    <color name="control_disabled_stroke">#DDE3EA</color>
    <!-- Drive activity. The dashboard could say "주행 준비 완료" and
         "DRIVING wp=921/1917" at the same time and never once say, in
         words, that the chair was moving right now. These are for the one
         line that does. -->
    <color name="drive_live_bg">#0B7A4B</color>
    <color name="drive_live_fill">#0E9460</color>
    <color name="drive_hold_bg">#FFF4D6</color>
