<?xml version="1.0" encoding="utf-8"?>
<!-- Hanyang-blue ground for the adaptive icon. The stock green Android
     grid shipped with the template and told an operator nothing about
     which app on the tablet drives the chair. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#0B4F83" />
    <!-- A soft diagonal sheen so the tile does not read as flat paper. -->
    <path
        android:pathData="M0,108L108,0L108,44L44,108z"
        android:fillColor="#14000000" />
    <path
        android:pathData="M0,0L52,0L0,52z"
        android:fillColor="#1AFFFFFF" />
</vector>
