<?xml version="1.0" encoding="utf-8"?>
<!-- Pitch, seen from the side: the chair nose-up on a slope, with the angle
     it makes against level ground. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="132dp"
    android:height="88dp"
    android:viewportWidth="132"
    android:viewportHeight="88">
    <!-- Level reference. -->
    <path android:pathData="M14,64 L120,64"
        android:strokeColor="#B9C6D4" android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- The ground the chair is actually on. -->
    <path android:pathData="M14,64 L118,36"
        android:strokeColor="#98A2B3" android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- Angle between them. -->
    <path android:pathData="M52,64 A38,38 0 0,0 50,54"
        android:strokeColor="#0175C2" android:strokeWidth="2.5"
        android:fillColor="#00000000" />
    <!-- Rear wheel. -->
    <path android:pathData="M62,49m-13,0a13,13 0,1 1,26 0a13,13 0,1 1,-26 0"
        android:strokeColor="#0B4F83" android:strokeWidth="3.5"
        android:fillColor="#00000000" />
    <!-- Front castor. -->
    <path android:pathData="M92,41m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0"
        android:strokeColor="#0B4F83" android:strokeWidth="3" 
        android:fillColor="#00000000" />
    <!-- Seat and backrest, leaning with the slope. -->
    <path android:pathData="M56,36 L92,26"
        android:strokeColor="#0B4F83" android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path android:pathData="M56,36 L48,14"
        android:strokeColor="#0B4F83" android:strokeWidth="4"
        android:strokeLineCap="round" />
</vector>
