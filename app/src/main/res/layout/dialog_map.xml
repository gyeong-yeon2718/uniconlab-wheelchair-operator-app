<?xml version="1.0" encoding="utf-8"?>
<!-- The map, big enough to work in. The dashboard card is fitted to show the
     whole route at once, which is the right default and useless for "which
     side of the path is the chair on". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/mapZoomText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mapCloseButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/close"
            android:textColor="@color/btn_label_primary"
            android:textSize="14sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hairline" />

    <com.example.jetsonbtmonitor.RouteMapView
        android:id="@+id/mapFullView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/card_background" />

    <TextView
        android:id="@+id/mapHintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:text="@string/map_hint"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mapZoomOutButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/map_zoom_out"
            android:textColor="@color/btn_label_primary"
            android:textSize="18sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mapZoomInButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/map_zoom_in"
            android:textColor="@color/btn_label_primary"
            android:textSize="18sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mapRotateButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/map_rotate"
            android:textColor="@color/btn_label_primary"
            android:textSize="14sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mapResetButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/map_reset"
            android:textColor="@color/btn_label_blue"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/btn_stroke_blue" />
    </LinearLayout>
</LinearLayout>
